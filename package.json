{
  "name": "ninja-quick",
  "version": "0.1.0",
  "description": "Windows desktop client for poe.ninja with POE 1/POE 2 switcher and unified search",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "electron test-integration.js",
    "clean-cache": "node -e \"const fs=require('fs');const path=require('path');const d=path.join(require('os').homedir(),`AppData/Roaming/ninja-quick/.cache`);if(fs.existsSync(d))fs.rmSync(d,{recursive:true});console.log('Cache cleared:',d)\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "playwright-core": "^1.61.1"
  },
  "dependencies": {
    "fuse.js": "^7.4.2"
  }
}
